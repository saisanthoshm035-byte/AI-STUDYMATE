# Copy this file to .env and add a key from ANY ONE provider.
# AI StudyMate auto-detects whichever provider is configured.
# If no key is found, the server falls back to a built-in demo lesson engine
# (used for the Photosynthesis demo) — the app always works.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (route to any model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Server port (default 8787)
PORT=8787
